# ── LLM ───────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-luna
FALLBACK_MODEL=gpt-5.6-luna
TEMPERATURE=0.3
MAX_TOKENS=1500
MAX_RETRIES=3

# ── Storage ───────────────────────────
STORAGE=sqlite
# Docker Compose overrides this with /data/chat_manager.db.
SQLITE_PATH=chat_manager.db
MONGO_URI=mongodb://localhost:27017
MONGO_DB=chat_manager

# ── Context budget ────────────────────
MAX_CONTEXT_TOKENS=32000
RESERVED_FOR_REPLY=1500
HISTORY_WINDOW=200
SUMMARY_TRIGGER_EVERY=10
CROSS_SESSION_SESSION_WINDOW=5
CROSS_SESSION_MESSAGE_WINDOW=40
CROSS_SESSION_WINDOW=5
CARRY_OVER_SCAN_LIMIT=20

# ── Optional speech ───────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
STT_MODEL=gpt-transcribe

# ── Server ────────────────────────────
HOST=127.0.0.1
PORT=8000
# Host-side port used by Docker Compose.
CHAT_MANAGER_PORT=8000
SESSION_TIMEOUT_MINUTES=5
TAX_RATE=0.0775
PICKUP_PREPARATION_MINUTES=20-30
DEBUG_CONTEXT=false
CALL_END_DELAY_SECONDS=20

# ── API auth ──────────────────────────
# Two named keys, not one shared secret. Both use the X-API-Key header.
# Leave both blank for local development; REQUIRED in production, where
# /chat and the dashboard endpoints are reachable over the network.
# Generate each with: openssl rand -hex 32
API_KEY_HEADER=X-API-Key
# Sent by the telephony gateway (as BRAIN_API_KEY in its own .env) -- valid
# on /chat only.
TELEPHONY_API_KEY=
# Sent by this repo's own bundled dashboard and by voice_central (as
# CHAT_MANAGER_API_KEY in its .env) -- valid on /chat plus every
# transcript/session/order/staff route.
DASHBOARD_API_KEY=

# ── Call disclosure ───────────────────
# Voice-only — never applies to non-voice channels regardless of this flag.
# Off by default; spoken once at the start of each call when enabled.
DISCLOSURE_ENABLED=false
DISCLOSURE_LINE=This call may be recorded and processed by our ordering assistant.
